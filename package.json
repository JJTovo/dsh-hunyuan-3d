{
  "name": "dsh-hunyuan-3d",
  "version": "0.1.0",
  "private": true,
  "description": "Tencent Cloud Hunyuan 3D (混元生3D / ai3d OpenAPI) modeling tools for dsh: text-to-3D and image-to-3D job submission with result polling and on-disk asset download.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JJTovo/dsh-hunyuan-3d.git"
  },
  "homepage": "https://github.com/JJTovo/dsh-hunyuan-3d#readme",
  "bugs": {
    "url": "https://github.com/JJTovo/dsh-hunyuan-3d/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "hunyuan",
    "hunyuan3d",
    "tencent-cloud",
    "ai3d",
    "text-to-3d",
    "image-to-3d"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./tc3": "./src/tc3.js",
    "./settings": "./src/settings.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "prepare": "node scripts/build-client.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^7.0.2"
  }
}
